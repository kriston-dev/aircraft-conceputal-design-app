<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>

<?import javafx.geometry.Insets?>


<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kriston.test1.TWDataInputController">
    <children>
        <Label text="enter span here:" />
        <TextField fx:id="spanInput"
            promptText="Enter reference wing in meters"
            style="-fx-prompt-text-fill: gray;"/>
        <Button text="T/W to Wing Loading Graph" onAction="#handleTWGraph"/>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
